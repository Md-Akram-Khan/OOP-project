# Copy this file to .env and fill it in. Never commit the real .env file.
# Both programs look for .env in the folder they run from and up to three folders above it.

# ---- Server only -------------------------------------------------------------
# Only the machine running the server needs these. Never give them to app users.
# Values come from Supabase > Project Settings > Database > Connection string (JDBC).
SUPABASE_DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=<your Supabase database password>

# Where the server listens. 127.0.0.1 = this computer only; 0.0.0.0 = all network interfaces.
EBS_SERVER_HOST=127.0.0.1
EBS_SERVER_PORT=8080

# Online payments with SSLCommerz (server only; leave out to turn online payment off).
# Free sandbox store for learning: https://developer.sslcommerz.com/registration/
# The shared public test store "testbox" / "qwerty" also works in sandbox mode.
SSLCOMMERZ_STORE_ID=<your sandbox store id>
SSLCOMMERZ_STORE_PASSWORD=<your sandbox store password>
# true = sandbox (test cards, no real money); false = live payments.
SSLCOMMERZ_SANDBOX=true
# Address the customer's browser returns to after paying. Only needed if the server isn't on this computer.
# EBS_PUBLIC_URL=https://your-server.example.com

# Firebase Phone Authentication for sign-up (server only): real SMS codes texted by Google.
# Needs a Firebase project on the Blaze (pay-as-you-go) plan with Phone sign-in enabled; the first
# 10 SMS a day aren't billed, after that about $0.19 per SMS to Bangladesh. Values are under
# Project settings > General > Your apps > Web app. When set, these take priority over SMS_* below.
# FIREBASE_API_KEY=AIza...
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# SMS for sign-up codes (server only). Leave out, or set SMS_MODE=demo, to show codes on screen
# instead of texting them (no SMS account needed). For real SMS, use a Bangladeshi gateway's HTTP API;
# {phone} (as 8801XXXXXXXXX) and {message} are filled in for each text.
# SMS_MODE=http
# SMS_HTTP_URL=https://bulksmsbd.net/api/smsapi?api_key=YOUR_KEY&type=text&number={phone}&senderid=YOUR_ID&message={message}

# NID card reading at sign-up (server only) uses Tesseract OCR, free and offline, when it's installed on the
# server machine (Windows: winget install UB-Mannheim.TesseractOCR). It's found on the PATH or in its usual
# install folder; set this only if it's somewhere else. Without Tesseract, a simpler built-in reader is used.
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- Desktop app only --------------------------------------------------------
# Address of the server. Use https:// for any server that isn't on this computer.
EBS_API_URL=http://localhost:8080
